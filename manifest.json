{
  "manifest_version": 3,
  "name": "Copy Selected Tab URLs",
  "short_name": "Copy Tab URLs",
  "description": "Copy URLs from selected Chrome tabs with one click.",
  "version": "1.0.1",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/vyctorbrzezowski/copy-selected-tab-urls",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "clipboardWrite",
    "contextMenus",
    "offscreen",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Copy selected tab URLs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
